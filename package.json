{
	"name": "@cloudflare/flagship-repo",
	"description": "The monorepo for Cloudflare's Flagship SDK and related packages",
	"type": "module",
	"keywords": [
		"cloudflare",
		"workers",
		"flagship"
	],
	"author": "Cloudflare",
	"private": true,
	"license": "Apache-2.0",
	"version": "0.0.0",
	"scripts": {
		"build": "pnpm -r run build",
		"changeset:validate": "tsx .github/changeset-version.ts validate",
		"format": "oxfmt --write .",
		"format:check": "oxfmt --check .",
		"lint": "oxlint .",
		"typecheck": "pnpm -r run typecheck",
		"check": "sherif && oxfmt --check . && oxlint . && pnpm run typecheck",
		"test": "pnpm -r run test",
		"prepare": "husky"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^0.7.0",
		"@changesets/cli": "^2.31.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.4",
		"oxfmt": "^0.49.0",
		"oxlint": "^1.64.0",
		"pkg-pr-new": "^0.0.71",
		"sherif": "^1.11.1",
		"tsx": "^4.21.0"
	},
	"packageManager": "pnpm@10.8.1",
	"overrides": {},
	"lint-staged": {
		"*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,css}": [
			"oxfmt --write"
		]
	}
}
